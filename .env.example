# Copy to .env and fill in. .env is gitignored and must never be committed.
# These three variables are the only server-side environment variables the service reads.

# Meta Model API key. Server-side only: never expose it to the browser and never
# put it behind a VITE_ prefix, which is inlined into the client bundle at build time.
MODEL_API_KEY=

# Public origin of the deployment. Used server-side only, to build the absolute
# image_link values inside the exported Commerce catalog CSV.
BASE_URL=http://127.0.0.1:8180

# true  -> every Meta call is served from recorded fixtures, with no network access.
# false -> calls go to the live Meta Model API and MODEL_API_KEY must be set.
META_MOCK=true
