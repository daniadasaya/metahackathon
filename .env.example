# Copy to .env and fill in. .env is gitignored and must never be committed.
# These two variables are the server-side environment variables the service reads in production.

# Meta Model API key. Server-side only: never expose it to the browser and never
# put it behind a VITE_ prefix, which is inlined into the client bundle at build time.
MODEL_API_KEY=

# Public origin of the deployment. Used server-side only, to build the absolute
# image_link values inside the exported Commerce catalog CSV.
BASE_URL=http://localhost:8180
