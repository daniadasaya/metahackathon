# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are the server-side environment variables the service reads, plus the
# two used by `docker compose` and by the deployment teardown script.

# Meta Model API key. Server-side only: never expose it to the browser and never
# put it behind a VITE_ prefix, which is inlined into the client bundle at build time.
MODEL_API_KEY=

# Public origin of the deployment. Used server-side only, to build the absolute
# image_link values inside the exported Commerce catalog CSV. Leave it at the
# loopback port for local work; a public deployment must set the real origin
# (for example https://metahackathon.my.id), or every exported CSV ships dead
# image URLs while the site itself looks healthy.
BASE_URL=http://localhost:8180

# Run the pipeline against the Meta Model API. Anything other than `false`
# means mock mode, and /api/health reports it - a demo on fake responses.
META_MOCK=false

# Cloudflare Tunnel connector (the `tunnel` service in docker-compose.yml).
# Only needed when the tunnel runs in this compose project.
TUNNEL_TOKEN=

# Cloudflare automation, used by scripts/nuke.sh --with-tunnel to delete the
# tunnel and its DNS records. Scoped to DNS:Edit and Cloudflare Tunnel:Edit.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_ZONE_NAME=
CF_TUNNEL_ID=
CF_TUNNEL_NAME=
