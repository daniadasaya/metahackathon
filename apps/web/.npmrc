# openapi-typescript 7.13.0 declares peer typescript@^5.x, but this project pins
# typescript@^7.0.2 for tsc. The generator itself is forced onto TS 5.9.3 at runtime
# via gen-types.cjs + the openapi-typescript-ts5 alias (see gen-types.cjs).
# legacy-peer-deps lets `npm ci` resolve the tree without failing on the peer range.
legacy-peer-deps=true
